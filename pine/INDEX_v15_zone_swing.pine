//@version=6
indicator("INDEX v15 — Zones + Swing Filter (45min research build)", overlay=true, max_labels_count=500, max_bars_back=600)

// v15 changes from v14
//  1. 3-bar persistence filter now works. In v14, confirmedUp/Down/Neutral were declared with `var`,
//     so they were computed once on the first bar and never again; finalBg always equalled prefinalBg.
//  2. Volume weighting is optional and OFF by default (volume = 1 on every bar), matching the Python backtest.
//  3. MACD removed.
//  4. Optional swing filter: rising valleys (for green) and falling peaks (for red), with BUY/SELL marks
//     on the bar where the Python backtest would enter. Defaults are one point of the research grid.
// Everything is evaluated on bar close. On a live, unclosed bar the zone and marks can still change.

// ──────────────────────────────────────────────────────────────
// 0. USER INPUTS
// ──────────────────────────────────────────────────────────────
enableAlerts      = input.bool(true,  "Enable Buy/Sell Alerts on Zone Change", group="Alerts")
showLabels        = input.bool(false, "Show BUY/SELL Labels on Zone Change",   group="Visuals")
showPlotShapes    = input.bool(false, "Show BUY/SELL Arrows on Zone Change",   group="Visuals")
carryThroughGaps  = input.bool(true,  "Carry zone color through EMA-ribbon-crossing bars (no black gaps)", group="Visuals")
useVolume         = input.bool(false, "Volume-weight the EMAs (off = volume 1 on every bar)", group="Signal")

showSwings  = input.bool(true,  "Show swing-filter entries", group="Swing filter")
pivN        = input.int(3,      "N: bars each side of a pivot", minval=1, maxval=20, group="Swing filter")
kProm       = input.float(0.75, "k: intervening swing ≥ k × ATR14", minval=0, step=0.25, group="Swing filter")
mSpace      = input.int(12,     "m: bars since previous pivot of the same kind ≥", minval=1, maxval=200, group="Swing filter")
jStep       = input.float(0.5,  "j: valley rise / peak fall ≥ j × ATR14", minval=0, step=0.25, group="Swing filter")
twWait      = input.int(2,      "tw: earliest entry, bars after the pivot is confirmed", minval=0, maxval=20, group="Swing filter")
staleBars   = input.int(16,     "Latest entry, bars after tw", minval=0, maxval=100, group="Swing filter")

// ──────────────────────────────────────────────────────────────
// 1. TIMEFRAME DETECTION
// ──────────────────────────────────────────────────────────────
tf              = timeframe.period
is10min         = tf == "10"
is20min         = tf == "20"
is30min         = tf == "30"
is45min         = tf == "45"
is60min         = tf == "60"
is120plus       = str.tonumber(tf) >= 120
is10or15        = tf == "10" or tf == "15"

higherTimeframe      = is10min ? "20" : is20min ? "40"  : is30min ? "60"  : is45min ? "90"  : is60min ? "120" : "240"
highestTimeframe     = is10min ? "40" : is20min ? "80"  : is30min ? "120" : is45min ? "180" : is60min ? "240" : "480"
highestestTimeframe  = is10min ? "80" : is20min ? "160" : is30min ? "240" : is45min ? "360" : is60min ? "480" : "960"

// ──────────────────────────────────────────────────────────────
// 2. EMA LENGTH SCALING
// ──────────────────────────────────────────────────────────────
var int s1 = 67, s2 = 36, s3 = 24
var int l1 = 42, l2 = 32, l3 = 6
var int h1 = 23, h2 = 30, h3 = 16
var int hh1 = 17, hh2 = 36, hh3 = 7

if is10or15
    s1 := 189, s2 := 119, s3 := 9
    h1 := 59,  h2 := 69,  h3 := 9
    hh1 := 41, hh2 := 61, hh3 := 9
    l1 := 129, l2 := 67,  l3 := 9
if is20min
    s1 := 201, s2 := 108, s3 := 24
    h1 := 69,  h2 := 90,  h3 := 16
    hh1 := 51, hh2 := 108, hh3 := 7
    l1 := 126, l2 := 96,  l3 := 6
if is30min
    s1 := 134, s2 := 72, s3 := 24
    h1 := 46,  h2 := 60, h3 := 16
    hh1 := 34, hh2 := 72, hh3 := 7
    l1 := 84,  l2 := 64, l3 := 6
if is45min
    s1 := 89, s2 := 48, s3 := 24
    h1 := 31, h2 := 40, h3 := 16
    hh1 := 23, hh2 := 48, hh3 := 7
    l1 := 56, l2 := 43, l3 := 6
if is60min
    s1 := 67, s2 := 36, s3 := 24
    h1 := 23, h2 := 30, h3 := 16
    hh1 := 17, hh2 := 36, hh3 := 7
    l1 := 42, l2 := 32, l3 := 6
if is120plus
    s1 := 68, s2 := 34, s3 := 24
    h1 := 24, h2 := 30, h3 := 17
    hh1 := 18, hh2 := 34, hh3 := 7
    l1 := 40, l2 := 32, l3 := 6

// ──────────────────────────────────────────────────────────────
// 3. (OPTIONALLY) VOLUME-WEIGHTED EMA
// ──────────────────────────────────────────────────────────────
calculateEMA(src, len1, len2, len3) =>
    v   = useVolume ? volume : 1.0
    vw1 = ta.ema(src * v, len1) / ta.ema(v, len1)
    vw2 = ta.ema(vw1, len2)
    ta.wma(2 * ta.wma(vw2, math.floor(len3 / 2)) - ta.wma(vw2, len3), math.round(math.sqrt(len3)))

short_ema = calculateEMA(close, math.max(s1, 2), math.max(s2, 2), math.max(s3, 2))
long_ema  = calculateEMA(close, math.max(l1, 2), math.max(l2, 2), math.max(l3, 2))

f_sec(_tf, _src) =>
    request.security(syminfo.tickerid, _tf, _src, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

htf_raw   = f_sec(higherTimeframe,     calculateEMA(close, math.max(h1, 2),  math.max(h2, 2),  math.max(h3, 2)))
hhtf_raw  = f_sec(highestTimeframe,    calculateEMA(close, math.max(hh1, 2), math.max(hh2, 2), math.max(hh3, 2)))
hhhtf_raw = f_sec(highestestTimeframe, calculateEMA(close, math.max(hh1, 2), math.max(hh2, 2), math.max(hh3, 2)))

higherTimeframeEma_Short     = ta.sma(htf_raw,   2)
highestTimeframeEma_Short    = ta.sma(hhtf_raw,  4)
highestestTimeframeEma_Short = ta.sma(hhhtf_raw, 8)

// ──────────────────────────────────────────────────────────────
// 4. DARK GREEN / DARK RED ZONES
// ──────────────────────────────────────────────────────────────
ema1 = short_ema
ema2 = long_ema
ema3 = higherTimeframeEma_Short
ema5 = highestTimeframeEma_Short
ema6 = highestestTimeframeEma_Short

darkGreen = color.new(#006400, 0)
darkRed   = color.new(#8B0000, 0)

var color prefinalBg = na
var color finalBg = na

fastEmasMax = math.max(ema2, ema3, ema5)
fastEmasMin = math.min(ema2, ema3, ema5)
slowEmasMax = math.max(ema1, ema6)
slowEmasMin = math.min(ema1, ema6)
maxEma = math.max(fastEmasMax, slowEmasMax)
minEma = math.min(fastEmasMin, slowEmasMin)

priceInBetweenEmas = ((close < fastEmasMin) and (close > slowEmasMax)) or ((close > fastEmasMax) and (close < slowEmasMin))

if priceInBetweenEmas
    prefinalBg := carryThroughGaps ? prefinalBg[1] : na
else if close > maxEma
    prefinalBg := darkGreen
else if close < minEma
    prefinalBg := darkRed
else
    prefinalBg := prefinalBg[1]

// 3-bar persistence, evaluated on every bar (no `var` here: that was the v14 bug)
confirmedUp      = prefinalBg == darkGreen and prefinalBg[1] == darkGreen and prefinalBg[2] == darkGreen
confirmedDown    = prefinalBg == darkRed   and prefinalBg[1] == darkRed   and prefinalBg[2] == darkRed
confirmedNeutral = na(prefinalBg) and na(prefinalBg[1]) and na(prefinalBg[2])

if confirmedUp
    finalBg := darkGreen
else if confirmedDown
    finalBg := darkRed
else if confirmedNeutral
    finalBg := na
// otherwise finalBg keeps its previous value (it is a `var`)

bgcolor(finalBg)

isGreen = finalBg == darkGreen
isRed   = finalBg == darkRed

// ──────────────────────────────────────────────────────────────
// 5. SWING FILTER: rising valleys and falling peaks
// ──────────────────────────────────────────────────────────────
// A pivot low is the lowest low of N bars on each side; it is known N bars later.
// It qualifies as a rising valley when, measured against the previous pivot low (qualifying or not):
//   bars between them ≥ m,  low rose by ≥ j × ATR14,  and the highest high between them is ≥ k × ATR14 above it.
// Falling peaks mirror this with pivot highs. ATR14 is read at the pivot bar.
atr14 = ta.atr(14)
pl = ta.pivotlow(low, pivN, pivN)
ph = ta.pivothigh(high, pivN, pivN)

var int   lastLowIdx  = na
var float lastLowVal  = na
var int   lastHighIdx = na
var float lastHighVal = na
var int   rvConfirmBar = na
var float rvLow        = na
var bool  rvUsed       = true
var int   fpConfirmBar = na
var float fpHigh       = na
var bool  fpUsed       = true

if not na(pl)
    idx = bar_index - pivN
    if not na(lastLowIdx)
        gap = idx - lastLowIdx
        hiBetween = high[pivN]
        for o = pivN to math.min(pivN + gap, 500)
            hiBetween := math.max(hiBetween, high[o])
        a = atr14[pivN]
        if gap >= mSpace and pl - lastLowVal >= jStep * a and hiBetween - pl >= kProm * a
            rvConfirmBar := bar_index
            rvLow := pl
            rvUsed := false
    lastLowIdx := idx
    lastLowVal := pl

if not na(ph)
    idx = bar_index - pivN
    if not na(lastHighIdx)
        gap = idx - lastHighIdx
        loBetween = low[pivN]
        for o = pivN to math.min(pivN + gap, 500)
            loBetween := math.min(loBetween, low[o])
        a = atr14[pivN]
        if gap >= mSpace and lastHighVal - ph >= jStep * a and ph - loBetween >= kProm * a
            fpConfirmBar := bar_index
            fpHigh := ph
            fpUsed := false
    lastHighIdx := idx
    lastHighVal := ph

sinceRV = bar_index - rvConfirmBar
sinceFP = bar_index - fpConfirmBar
bullEntry = not rvUsed and sinceRV >= twWait and sinceRV <= twWait + staleBars and isGreen and close > rvLow
bearEntry = not fpUsed and sinceFP >= twWait and sinceFP <= twWait + staleBars and isRed and close < fpHigh
if bullEntry
    rvUsed := true
if bearEntry
    fpUsed := true
if not rvUsed and (sinceRV > twWait + staleBars or close <= rvLow)
    rvUsed := true
if not fpUsed and (sinceFP > twWait + staleBars or close >= fpHigh)
    fpUsed := true

plotshape(showSwings and bullEntry, title="Swing BUY",  location=location.belowbar, color=color.aqua,   style=shape.labelup,   text="RV", textcolor=color.black, size=size.small)
plotshape(showSwings and bearEntry, title="Swing SELL", location=location.abovebar, color=color.orange, style=shape.labeldown, text="FP", textcolor=color.black, size=size.small)
plotshape(showSwings and not na(pl), title="Pivot low",  location=location.belowbar, color=color.new(color.aqua, 60),   style=shape.circle, size=size.tiny, offset=-pivN)
plotshape(showSwings and not na(ph), title="Pivot high", location=location.abovebar, color=color.new(color.orange, 60), style=shape.circle, size=size.tiny, offset=-pivN)

// ──────────────────────────────────────────────────────────────
// 6. ALERTS AND MARKERS (bar close)
// ──────────────────────────────────────────────────────────────
changedToGreen = isGreen and finalBg[1] != darkGreen
changedToRed   = isRed   and finalBg[1] != darkRed

alertcondition(enableAlerts and changedToGreen, title="Zone → Green", message="Zone turned green: {{ticker}} {{interval}}")
alertcondition(enableAlerts and changedToRed,   title="Zone → Red",   message="Zone turned red: {{ticker}} {{interval}}")
alertcondition(bullEntry, title="Swing BUY (rising valley in green)", message="Rising valley entry: {{ticker}} {{interval}}")
alertcondition(bearEntry, title="Swing SELL (falling peak in red)",  message="Falling peak entry: {{ticker}} {{interval}}")

plotshape(showPlotShapes and changedToGreen, title="Buy Marker",  location=location.belowbar, color=color.lime, style=shape.triangleup,   size=size.large, text="BUY")
plotshape(showPlotShapes and changedToRed,   title="Sell Marker", location=location.abovebar, color=color.red,  style=shape.triangledown, size=size.large, text="SELL")

if showLabels and changedToGreen and barstate.isconfirmed
    label.new(bar_index, close, "BUY\n" + str.tostring(close, "#.##"), style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.small)
if showLabels and changedToRed and barstate.isconfirmed
    label.new(bar_index, close, "SELL\n" + str.tostring(close, "#.##"), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ──────────────────────────────────────────────────────────────
// 7. PLOTS
// ──────────────────────────────────────────────────────────────
plot(short_ema,  "Short EMA",  color=color.yellow, linewidth=1)
plot(long_ema,   "Long EMA",   color=color.orange, linewidth=1)
plot(higherTimeframeEma_Short,     "HTF Short",   color=color.blue,    linewidth=1)
plot(highestTimeframeEma_Short,    "HHTF Short",  color=color.fuchsia, linewidth=1)
plot(highestestTimeframeEma_Short, "HHHTF Short", color=color.white,   linewidth=1)
